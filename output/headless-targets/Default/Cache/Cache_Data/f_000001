<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>海上态势知识更新工作台</title>
<style>
:root{--bg:#f4f6f8;--surface:#fff;--ink:#172033;--muted:#667085;--line:#d9e0e8;--nav:#17304f;--nav2:#24486f;--blue:#245ea9;--blue-bg:#eaf2fc;--green:#187456;--green-bg:#e9f6f0;--orange:#9b5a12;--orange-bg:#fff3df;--red:#b42318;--red-bg:#fff0ed}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.55 "Microsoft YaHei","Segoe UI",sans-serif}button,select,input,textarea{font:inherit}button{border:0;border-radius:5px;padding:9px 13px;background:var(--blue);color:#fff;cursor:pointer}button:hover{filter:brightness(.96)}button.secondary{background:#fff;color:var(--blue);border:1px solid #aec0d7}button.ghost{background:transparent;color:var(--blue);padding:6px 8px}button.danger{background:var(--red)}button:disabled{opacity:.5;cursor:not-allowed}select,input,textarea{border:1px solid var(--line);border-radius:5px;padding:9px 10px;background:#fff;color:var(--ink)}textarea{width:100%;min-height:78px;resize:vertical}.app{min-height:100vh;display:grid;grid-template-columns:236px minmax(0,1fr)}
.side{background:var(--nav);color:#dce8f6;padding:20px 14px;position:sticky;top:0;height:100vh;overflow:auto}.brand{font-size:17px;font-weight:700;color:#fff;padding:0 8px}.brand-sub{color:#9fb3ca;font-size:12px;padding:2px 8px 22px}.nav-label{font-size:11px;color:#88a0bb;margin:13px 9px 6px}.nav-item{width:100%;display:flex;align-items:center;justify-content:space-between;background:transparent;color:#dce8f6;text-align:left;padding:10px 11px;margin:2px 0}.nav-item:hover{background:#203f63;filter:none}.nav-item.active{background:var(--nav2);color:#fff}.nav-item .count{min-width:22px;text-align:center;background:#c83c32;color:#fff;border-radius:10px;font-size:11px;padding:0 6px}.side-status{margin-top:24px;border-top:1px solid #355574;padding:15px 8px;color:#b9c9da;font-size:12px}.side-status strong{display:block;color:#fff;margin-bottom:4px}
.main{min-width:0;padding:22px 26px 40px;max-width:1560px;width:100%;margin:0 auto}.top{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:16px}.breadcrumb{color:var(--blue);font-size:12px;font-weight:600}.top h1{font-size:24px;margin:2px 0 1px;letter-spacing:0}.top p{margin:0;color:var(--muted)}.actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.message{background:var(--blue-bg);color:#244f83;border-left:4px solid var(--blue);padding:10px 13px;border-radius:4px;margin-bottom:16px}.view[hidden]{display:none}.summary{display:grid;grid-template-columns:repeat(5,minmax(130px,1fr));gap:10px;margin-bottom:14px}.metric,.panel{background:var(--surface);border:1px solid var(--line);border-radius:6px}.metric{padding:13px}.metric label{display:block;color:var(--muted);font-size:12px}.metric strong{display:block;font-size:22px;margin-top:2px}.metric .detail{font-size:12px;color:var(--muted)}.panel{padding:16px}.panel h2{font-size:16px;margin:0}.panel h3{font-size:14px;margin:0}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px}.grid-2{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(320px,.65fr);gap:14px}.grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.stack{display:grid;gap:10px}.row{display:flex;align-items:center;justify-content:space-between;gap:10px}.wrap{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.card{border:1px solid var(--line);border-radius:5px;padding:12px;background:#fff}.card.attention{border-left:4px solid var(--orange);background:var(--orange-bg)}.card.alert{border-left:4px solid var(--red);background:var(--red-bg)}.card.good{border-left:4px solid var(--green);background:var(--green-bg)}.card.selected{border-color:#79a0d0;background:var(--blue-bg)}.card strong{display:block}.small{font-size:12px;color:var(--muted)}.empty{color:var(--muted);padding:24px 8px;text-align:center}.pill{display:inline-block;padding:2px 8px;border-radius:12px;background:var(--blue-bg);color:var(--blue);font-size:12px;white-space:nowrap}.pill.good{background:var(--green-bg);color:var(--green)}.pill.warn{background:var(--orange-bg);color:var(--orange)}.pill.bad{background:var(--red-bg);color:var(--red)}.progress{height:6px;background:#e7ebf0;overflow:hidden;border-radius:4px;margin-top:8px}.progress i{display:block;height:100%;background:var(--blue)}
.pipeline{display:grid;grid-template-columns:repeat(5,1fr);gap:0}.stage{position:relative;padding:12px 10px;border-top:3px solid var(--line);background:#f9fafb;min-height:83px}.stage+.stage{border-left:1px solid var(--line)}.stage.done{border-top-color:var(--green)}.stage.attention{border-top-color:var(--orange);background:var(--orange-bg)}.stage strong{display:block;font-size:13px}.stage span{font-size:12px;color:var(--muted)}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse}.table th,.table td{text-align:left;padding:9px 8px;border-bottom:1px solid var(--line);vertical-align:top}.table th{color:var(--muted);font-size:12px;font-weight:500;background:#fafbfc}.table tr.selectable{cursor:pointer}.table tr.selectable:hover{background:#f6f9fd}.table tr.selected{background:var(--blue-bg)}
.target-layout{display:grid;grid-template-columns:310px minmax(0,1fr);gap:14px}.target-list button{display:block;width:100%;text-align:left;background:#fff;color:var(--ink);border:1px solid var(--line);padding:12px}.target-list button.selected{border-color:#7399c7;background:var(--blue-bg)}.track{background:#f5f8fb;border:1px solid var(--line);border-radius:5px;min-height:340px}.track svg{display:block;width:100%;height:340px}.track .gridline{stroke:#d9e0e8;stroke-width:1}.track .route{stroke:#2f69ad;stroke-width:3;fill:none}.track .radar{fill:#e28a2b}.track .ais{fill:#2462a7}.track text{fill:#667085;font:12px "Microsoft YaHei"}.facts{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.factbox{background:#f8fafc;padding:10px;border-radius:4px}.factbox label{display:block;color:var(--muted);font-size:12px}.factbox strong{font-size:15px}.review-layout{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:14px}.review-card{border:1px solid var(--line);background:#fff;border-radius:6px;padding:15px}.review-card.pending{border-left:4px solid var(--orange)}.review-card.committed,.review-card.approved{border-left:4px solid var(--green)}.review-card.rejected,.review-card.failed{border-left:4px solid var(--red)}.review-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.evidence{margin-top:10px;padding-top:10px;border-top:1px solid var(--line)}.version-list{position:relative;padding-left:22px}.version-item{position:relative;border-left:2px solid #b8c7d8;padding:0 0 20px 20px}.version-item:before{content:"";position:absolute;left:-7px;top:3px;width:12px;height:12px;border-radius:50%;background:#91a6bd}.version-item.current:before{background:var(--green)}.layer{border-top:4px solid var(--blue);background:#fff;padding:14px;border-radius:5px;border-left:1px solid var(--line);border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.layer h3{margin:0 0 8px}.rule{display:grid;grid-template-columns:minmax(150px,.35fr) 1fr auto;gap:12px;align-items:center;border-bottom:1px solid var(--line);padding:11px 0}.source-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.source{border:1px solid var(--line);padding:12px;border-radius:5px}.dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--green);margin-right:6px}.modal{position:fixed;inset:0;background:#14223899;display:none;align-items:center;justify-content:center;padding:20px;z-index:20}.modal.open{display:flex}.dialog{background:#fff;width:min(540px,100%);border-radius:7px;padding:22px;box-shadow:0 18px 55px #10223b33}.dialog h2{margin:0 0 7px;font-size:19px}.dialog p{color:var(--muted);margin:0 0 14px}.dialog-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}.toast{position:fixed;right:20px;bottom:20px;background:#172033;color:#fff;padding:10px 14px;border-radius:5px;display:none;z-index:30}.toast.show{display:block}.mobile-nav{display:none}
@media(max-width:1120px){.app{grid-template-columns:200px minmax(0,1fr)}.summary{grid-template-columns:repeat(3,1fr)}.grid-2,.review-layout{grid-template-columns:1fr}.pipeline{grid-template-columns:1fr}.stage+.stage{border-left:0;border-top:1px solid var(--line);border-left:3px solid var(--line)}.stage.done{border-left-color:var(--green)}.stage.attention{border-left-color:var(--orange)}.target-layout{grid-template-columns:250px 1fr}.facts{grid-template-columns:repeat(2,1fr)}}
@media(max-width:760px){.app{display:block}.side{display:none}.main{padding:14px}.mobile-nav{display:flex;gap:5px;overflow:auto;margin-bottom:12px}.mobile-nav button{white-space:nowrap;background:#fff;color:var(--blue);border:1px solid var(--line)}.mobile-nav button.active{background:var(--nav);color:#fff}.top{display:block}.actions{justify-content:flex-start;margin-top:12px}.summary,.grid-3,.source-grid{grid-template-columns:1fr 1fr}.target-layout{grid-template-columns:1fr}.rule{grid-template-columns:1fr}.facts{grid-template-columns:1fr 1fr}}
@media(max-width:470px){.summary,.grid-3,.source-grid,.facts{grid-template-columns:1fr}.actions>*{width:100%}}
</style>
</head>
<body>
<div class="app">
<aside class="side">
  <div class="brand">海上态势工作台</div><div class="brand-sub">知识更新原型软件</div>
  <div class="nav-label">业务工作区</div>
  <button class="nav-item active" data-view="overview">态势总览</button>
  <button class="nav-item" data-view="targets">目标与轨迹</button>
  <button class="nav-item" data-view="review">更新审核 <span id="navCount" class="count" hidden>0</span></button>
  <button class="nav-item" data-view="versions">版本记录</button>
  <div class="nav-label">知识更新链路</div>
  <button class="nav-item" data-view="ingestion">数据接入</button>
  <button class="nav-item" data-view="ontology">规则与本体</button>
  <div class="side-status"><strong id="sideState">系统就绪</strong><span id="sideVersion">图谱 v0 · 本体 v0.1.0</span></div>
</aside>
<main class="main">
  <nav class="mobile-nav" aria-label="工作区"></nav>
  <header class="top">
    <div><div id="breadcrumb" class="breadcrumb">知识更新 / 实时研判</div><h1 id="pageTitle">海上态势总览</h1><p id="pageSubtitle">统一查看数据接入、异常研判和知识更新状态。</p></div>
    <div class="actions"><select id="scenario" aria-label="演示场景"></select><button id="reset" class="secondary">切换场景</button><button id="receive">接收下一批</button><button id="run">接收全部</button></div>
  </header>
  <div id="message" class="message" aria-live="polite">正在连接工作台...</div>

  <section id="view-overview" class="view">
    <div class="summary">
      <div class="metric"><label>数据接收进度</label><strong id="mProgress">0%</strong><div class="progress"><i id="progressBar" style="width:0"></i></div></div>
      <div class="metric"><label>当前目标</label><strong id="mTargets">0</strong><span class="detail">已完成跨模态关联</span></div>
      <div class="metric"><label>待审核事项</label><strong id="mPending">0</strong><span class="detail">需要值班员确认</span></div>
      <div class="metric"><label>正式图谱版本</label><strong id="mGraph">v0</strong><span class="detail" id="mTriples">0 条知识</span></div>
      <div class="metric"><label>当前本体版本</label><strong id="mOntology">v0.1.0</strong><span class="detail">语义模型</span></div>
    </div>
    <div class="panel" style="margin-bottom:14px"><div class="panel-head"><h2>知识更新处理链路</h2><span class="small">每一步都有状态和记录</span></div><div id="pipeline" class="pipeline"></div></div>
    <div class="grid-2">
      <section class="panel"><div class="panel-head"><h2>目标态势</h2><button class="ghost" data-go="targets">查看全部目标</button></div><div id="overviewTargets" class="table-wrap"></div></section>
      <section class="panel"><div class="panel-head"><h2>需要处理</h2><button class="ghost" data-go="review">进入审核中心</button></div><div id="overviewReviews" class="stack"></div></section>
    </div>
  </section>

  <section id="view-targets" class="view" hidden>
    <div class="target-layout">
      <section class="panel"><div class="panel-head"><h2>监测目标</h2><span id="targetTotal" class="pill">0</span></div><div id="targetList" class="target-list stack"></div></section>
      <div class="stack">
        <section class="panel"><div class="panel-head"><div><h2 id="targetTitle">请选择目标</h2><div id="targetStatus" class="small"></div></div><button id="targetReviewBtn" hidden>处理待审核更新</button></div><div id="targetFacts" class="facts"></div></section>
        <section class="panel"><div class="panel-head"><h2>融合轨迹</h2><span class="small">蓝色：AIS　橙色：雷达</span></div><div id="track" class="track"></div></section>
        <section class="panel"><div class="panel-head"><h2>观测证据</h2><span id="targetEvidenceCount" class="small"></span></div><div id="targetEvidence" class="table-wrap"></div></section>
      </div>
    </div>
  </section>

  <section id="view-review" class="view" hidden>
    <div class="review-layout">
      <section class="panel"><div class="panel-head"><h2>审核队列</h2><span id="reviewSummary" class="small"></span></div><div id="reviewQueue" class="stack"></div></section>
      <div class="stack">
        <section class="panel"><h2 style="margin-bottom:10px">审核原则</h2><div class="small">系统只提供证据链、规则命中结果和一致性预检。正式知识更新与本体演化都必须由工作人员确认。</div></section>
        <section class="panel"><h2 style="margin-bottom:10px">最近操作</h2><div id="reviewAudit" class="stack"></div></section>
      </div>
    </div>
  </section>

  <section id="view-versions" class="view" hidden>
    <div class="grid-2">
      <section class="panel"><div class="panel-head"><h2>图谱版本</h2><span class="pill good" id="currentVersion">当前 v0</span></div><div id="versionList" class="version-list"></div></section>
      <section class="panel"><div class="panel-head"><h2>版本说明</h2></div><div class="card"><strong>原子提交</strong><div class="small">一个变更集中的状态、事件、证据关系同时成功或同时失败。</div></div><div class="card" style="margin-top:8px"><strong>可追溯恢复</strong><div class="small">每次正式提交都保存快照，可恢复到任一已有版本。</div></div></section>
    </div>
    <section class="panel" style="margin-top:14px"><div class="panel-head"><h2>完整操作日志</h2><span class="small">场景初始化、数据接入、审核与版本操作均留痕</span></div><div id="auditTable" class="table-wrap"></div></section>
  </section>

  <section id="view-ingestion" class="view" hidden>
    <div id="sources" class="source-grid" style="margin-bottom:14px"></div>
    <div class="grid-2">
      <section class="panel"><div class="panel-head"><h2>接收批次</h2><span class="small">自动去重并统一时间、坐标、单位和标识</span></div><div id="batchTable" class="table-wrap"></div></section>
      <section class="panel"><div class="panel-head"><h2>场景说明</h2></div><div id="scenarioInfo"></div></section>
    </div>
    <section class="panel" style="margin-top:14px"><div class="panel-head"><h2>标准化观测记录</h2><span id="observationCount" class="small"></span></div><div id="observationTable" class="table-wrap"></div></section>
  </section>

  <section id="view-ontology" class="view" hidden>
    <div class="summary">
      <div class="metric"><label>当前本体</label><strong id="oVersion">v0.1.0</strong><span class="detail">人工批准后升级</span></div>
      <div class="metric"><label>映射字段</label><strong id="oMappings">0</strong><span class="detail">统一语义映射</span></div>
      <div class="metric"><label>启用规则</label><strong id="oRules">0</strong><span class="detail">时空与关联规则</span></div>
      <div class="metric"><label>演化建议</label><strong id="oProposals">0</strong><span class="detail">包含历史建议</span></div>
      <div class="metric"><label>一致性约束</label><strong>OWL + SHACL</strong><span class="detail">提交前强制校验</span></div>
    </div>
    <div id="ontologyLayers" class="grid-3" style="grid-template-columns:repeat(4,1fr);margin-bottom:14px"></div>
    <section class="panel" style="margin-bottom:14px"><div class="panel-head"><h2>规则库</h2><span class="small">当前原型采用可重复测试的确定性规则</span></div><div id="ruleList"></div></section>
    <section class="panel"><div class="panel-head"><h2>本体演化建议</h2><span class="small">批准后生成新版本并立即成为当前本体</span></div><div id="ontologyReviews" class="stack"></div></section>
  </section>
</main>
</div>

<div id="modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="dialog"><h2 id="modalTitle"></h2><p id="modalText"></p><div id="reasonWrap" hidden><label for="reason" class="small">处理原因</label><textarea id="reason" placeholder="请输入判断依据，便于后续追溯"></textarea></div><div class="dialog-actions"><button id="cancelModal" class="secondary">取消</button><button id="confirmModal">确认</button></div></div>
</div>
<div id="toast" class="toast" aria-live="polite"></div>

<script>
const $=id=>document.getElementById(id);
const meta={
 overview:["知识更新 / 实时研判","海上态势总览","统一查看数据接入、异常研判和知识更新状态。"],
 targets:["业务工作区 / 目标与轨迹","目标与轨迹","选择目标查看融合轨迹、状态和跨模态证据。"],
 review:["业务工作区 / 更新审核","更新审核中心","批准或拒绝候选事实与本体演化建议。"],
 versions:["业务工作区 / 版本记录","版本与审计","查看正式图谱快照、恢复历史版本并追溯操作。"],
 ingestion:["知识更新链路 / 数据接入","多模态数据接入","查看各来源数据、标准化结果、批次和去重情况。"],
 ontology:["知识更新链路 / 规则与本体","规则与本体管理","查看四层本体、判定规则和演化审批状态。"]
};
let state=null,scenarios=[],activeView=(location.hash||"#overview").slice(1),selectedTarget=null,busy=false;
function esc(v){return String(v??"").replace(/[&<>\"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]))}
function fmt(t){if(!t)return "-";return new Date(t).toLocaleString("zh-CN",{hour12:false})}
function statusText(s){return {pending:"待审核",committed:"已提交",approved:"已批准",rejected:"已拒绝",failed:"校验失败",done:"已完成",waiting:"等待中",attention:"需处理"}[s]||s}
function statusPill(s){const k={committed:"good",approved:"good",done:"good",pending:"warn",attention:"warn",rejected:"bad",failed:"bad"}[s]||"";return `<span class="pill ${k}">${esc(statusText(s))}</span>`}
async function api(path,method="GET",body){const r=await fetch(path,{method,headers:body?{"Content-Type":"application/json"}:{},body:body?JSON.stringify(body):undefined});const d=await r.json();if(!r.ok)throw new Error(d.error||"操作失败");return d}
function toast(text){$('toast').textContent=text;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),2600)}
function navigate(view){if(!meta[view])view="overview";activeView=view;location.hash=view;document.querySelectorAll('.view').forEach(x=>x.hidden=x.id!==`view-${view}`);document.querySelectorAll('[data-view]').forEach(x=>x.classList.toggle('active',x.dataset.view===view));const m=meta[view];$('breadcrumb').textContent=m[0];$('pageTitle').textContent=m[1];$('pageSubtitle').textContent=m[2];window.scrollTo({top:0,behavior:'smooth'})}
async function perform(path,body){if(busy)return;busy=true;document.querySelectorAll('button').forEach(x=>x.disabled=true);try{state=await api(path,'POST',body);render();toast(state.message)}catch(e){toast(e.message)}finally{busy=false;document.querySelectorAll('button').forEach(x=>x.disabled=false)}}
function openConfirm(title,text,action,{reason=false,danger=false}={}){$('modalTitle').textContent=title;$('modalText').textContent=text;$('reasonWrap').hidden=!reason;$('reason').value="";$('confirmModal').className=danger?'danger':'';$('modal').classList.add('open');$('confirmModal').onclick=async()=>{const value=$('reason').value.trim();if(reason&&!value){$('reason').focus();return} $('modal').classList.remove('open');await action(value)}}
$('cancelModal').onclick=()=>$('modal').classList.remove('open');
function reviewForTarget(id){return state.fact_reviews.find(x=>x.vessel_id===id)}
function renderOverview(){const p=state.progress;$('mProgress').textContent=`${p.percent}%`;$('progressBar').style.width=p.percent+'%';$('mTargets').textContent=state.targets.length;$('mPending').textContent=state.pending_count;$('mGraph').textContent='v'+state.graph_version;$('mTriples').textContent=`${state.triple_count} 条知识`;$('mOntology').textContent='v'+state.ontology.version;
 $('pipeline').innerHTML=state.pipeline.map(x=>`<div class="stage ${esc(x.status)}"><strong>${esc(x.name)}</strong><span>${esc(x.detail)}</span></div>`).join('');
 $('overviewTargets').innerHTML=state.targets.length?`<table class="table"><thead><tr><th>目标</th><th>状态</th><th>速度</th><th>来源</th><th>区域</th></tr></thead><tbody>${state.targets.map(t=>`<tr class="selectable" onclick="selectAndGo('${esc(t.id)}')"><td><strong>${esc(t.id)}</strong></td><td>${statusPill(t.review_status||'done').replace(statusText(t.review_status||'done'),esc(t.status))}</td><td>${t.speed??'-'} m/s</td><td>${t.modalities.map(esc).join(' / ')}</td><td>${esc(t.area)}</td></tr>`).join('')}</tbody></table>`:`<div class="empty">尚未接收目标数据</div>`;
 const pending=[...state.fact_reviews.filter(x=>x.status==='pending').map(x=>({type:'fact',x})),...state.proposals.filter(x=>x.status==='pending').map(x=>({type:'ontology',x}))];$('overviewReviews').innerHTML=pending.length?pending.slice(0,4).map(i=>i.type==='fact'?`<div class="card alert"><strong>目标 ${esc(i.x.vessel_id)} 疑似异常悬停</strong><div class="small">${i.x.evidence_ids.length} 条证据 · 可信度 ${i.x.confidence}</div></div>`:`<div class="card attention"><strong>新字段 ${esc(i.x.source_field)}</strong><div class="small">需要确认是否扩展本体</div></div>`).join(''):`<div class="empty">暂无待处理事项</div>`}
function selectAndGo(id){selectedTarget=id;navigate('targets');renderTargets()}
function trackSvg(points){if(!points.length)return `<div class="empty">暂无轨迹坐标</div>`;const w=780,h=340,pad=45,xv=points.map(p=>p.longitude),yv=points.map(p=>p.latitude),xmin=Math.min(...xv),xmax=Math.max(...xv),ymin=Math.min(...yv),ymax=Math.max(...yv),dx=xmax-xmin||.001,dy=ymax-ymin||.001,x=v=>pad+(v-xmin)/dx*(w-pad*2),y=v=>h-pad-(v-ymin)/dy*(h-pad*2);const ordered=[...points].sort((a,b)=>new Date(a.time)-new Date(b.time));const path=ordered.map((p,i)=>`${i?'L':'M'}${x(p.longitude).toFixed(1)},${y(p.latitude).toFixed(1)}`).join(' ');return `<svg viewBox="0 0 ${w} ${h}" role="img" aria-label="目标融合轨迹"><line class="gridline" x1="${pad}" y1="${h/2}" x2="${w-pad}" y2="${h/2}"/><line class="gridline" x1="${w/2}" y1="${pad}" x2="${w/2}" y2="${h-pad}"/><path class="route" d="${path}"/>${ordered.map((p,i)=>`<circle class="${esc(p.modality)}" cx="${x(p.longitude)}" cy="${y(p.latitude)}" r="6"><title>${esc(p.modality)} ${fmt(p.time)} 速度 ${p.speed} m/s</title></circle>${i===0||i===ordered.length-1?`<text x="${x(p.longitude)+9}" y="${y(p.latitude)-8}">${i===0?'起点':'最新'}</text>`:''}`).join('')}<text x="${pad}" y="${h-12}">经度 ${xmin.toFixed(4)} - ${xmax.toFixed(4)}</text><text x="${w-pad}" y="${h-12}" text-anchor="end">纬度 ${ymin.toFixed(4)} - ${ymax.toFixed(4)}</text></svg>`}
function renderTargets(){if(!selectedTarget&&state.targets.length)selectedTarget=state.targets[0].id;if(selectedTarget&&!state.targets.some(x=>x.id===selectedTarget))selectedTarget=state.targets[0]?.id||null;$('targetTotal').textContent=state.targets.length;$('targetList').innerHTML=state.targets.length?state.targets.map(t=>`<button class="${t.id===selectedTarget?'selected':''}" onclick="selectedTarget='${esc(t.id)}';renderTargets()"><div class="row"><strong>${esc(t.id)}</strong>${statusPill(t.review_status||'done')}</div><div class="small">${esc(t.area)} · ${t.observation_count} 条观测</div></button>`).join(''):`<div class="empty">尚未接收目标</div>`;const t=state.targets.find(x=>x.id===selectedTarget);if(!t){$('targetTitle').textContent='请选择目标';$('targetFacts').innerHTML='';$('track').innerHTML='<div class="empty">暂无轨迹</div>';$('targetEvidence').innerHTML='';return}const rv=reviewForTarget(t.id);$('targetTitle').textContent=`目标 ${t.id}`;$('targetStatus').innerHTML=`${statusPill(t.review_status||'done')} ${esc(t.status)}`;$('targetFacts').innerHTML=`<div class="factbox"><label>最新速度</label><strong>${t.speed??'-'} m/s</strong></div><div class="factbox"><label>航向</label><strong>${t.course??'-'}°</strong></div><div class="factbox"><label>综合可信度</label><strong>${t.confidence}</strong></div><div class="factbox"><label>所在区域</label><strong>${esc(t.area)}</strong></div>`;$('track').innerHTML=trackSvg(t.track);const obs=state.observations.filter(o=>(o.payload.mmsi||o.payload.correlated_mmsi)===t.id);$('targetEvidenceCount').textContent=`${obs.length} 条`;$('targetEvidence').innerHTML=observationTable(obs);$('targetReviewBtn').hidden=!(rv&&rv.status==='pending');$('targetReviewBtn').onclick=()=>navigate('review')}
function observationTable(items){if(!items.length)return `<div class="empty">暂无记录</div>`;return `<table class="table"><thead><tr><th>观测时间</th><th>来源</th><th>速度</th><th>位置</th><th>可信度</th></tr></thead><tbody>${items.map(o=>`<tr><td>${fmt(o.observed_at)}</td><td>${esc(o.modality)}</td><td>${o.speed_mps??'-'} m/s</td><td>${o.position?`${o.position.longitude.toFixed(4)}, ${o.position.latitude.toFixed(4)}`:'-'}</td><td>${o.confidence}</td></tr>`).join('')}</tbody></table>`}
function approveFact(id){openConfirm('批准知识更新？','系统会再次执行一致性校验，通过后将状态、事件和证据关系原子写入正式图谱。',()=>perform('/api/action/approve-fact',{fact_id:id}))}
function rejectFact(id){openConfirm('拒绝候选事实？','拒绝后正式图谱不会改变，原因将进入审计日志。',reason=>perform('/api/action/reject-fact',{fact_id:id,reason}),{reason:true,danger:true})}
function approveOntology(id){openConfirm('批准本体演化？','系统会把新字段加入本体、生成下一版本并设为当前语义模型，原版本仍保留。',()=>perform('/api/action/approve-evolution',{proposal_id:id}))}
function rejectOntology(id){openConfirm('拒绝本体演化？','该字段不会进入当前业务本体，处理原因会被记录。',reason=>perform('/api/action/reject-evolution',{proposal_id:id,reason}),{reason:true,danger:true})}
function factCard(x){const valid=x.validation.at(-1)?.valid;return `<article class="review-card ${esc(x.status)}"><div class="row"><div><span class="small">候选事实 · ${esc(x.fact_id)}</span><strong>目标 ${esc(x.vessel_id)}：异常悬停</strong></div>${statusPill(x.status)}</div><div class="evidence"><div class="wrap"><span class="pill">${x.evidence_ids.length} 条证据</span><span class="pill">可信度 ${x.confidence}</span><span class="pill ${valid?'good':'bad'}">一致性预检${valid?'通过':'未通过'}</span></div><div class="small" style="margin-top:7px">有效起始：${fmt(x.valid_from)} · 证据来源包含 AIS 与雷达</div>${x.reason?`<div class="small">处理原因：${esc(x.reason)}</div>`:''}</div>${x.status==='pending'?`<div class="review-actions"><button onclick="approveFact('${esc(x.fact_id)}')">批准并提交</button><button class="secondary" onclick="rejectFact('${esc(x.fact_id)}')">拒绝</button></div>`:''}</article>`}
function ontologyCard(x){return `<article class="review-card ${esc(x.status)}"><div class="row"><div><span class="small">本体演化 · ${esc(x.proposal_id)}</span><strong>新增字段映射：${esc(x.source_field)}</strong></div>${statusPill(x.status)}</div><div class="evidence"><div class="small">建议术语：${esc(x.suggested_term.split('/').at(-1))}</div><div class="small">定义域：Observation · 类型：decimal · 证据 ${x.evidence_ids.length} 条</div>${x.generated_version?`<div class="small">已生成本体 v${esc(x.generated_version)}</div>`:''}${x.reason?`<div class="small">处理原因：${esc(x.reason)}</div>`:''}</div>${x.status==='pending'?`<div class="review-actions"><button onclick="approveOntology('${esc(x.proposal_id)}')">批准演化</button><button class="secondary" onclick="rejectOntology('${esc(x.proposal_id)}')">拒绝</button></div>`:''}</article>`}
function renderReview(){const items=[...state.fact_reviews.map(x=>({t:'f',x})),...state.proposals.map(x=>({t:'o',x}))].sort((a,b)=>(a.x.status==='pending'?-1:1)-(b.x.status==='pending'?-1:1));$('reviewSummary').textContent=`${state.pending_count} 项待审核 · ${items.length} 项全部记录`;$('reviewQueue').innerHTML=items.length?items.map(i=>i.t==='f'?factCard(i.x):ontologyCard(i.x)).join(''):`<div class="empty">接收数据后，候选事实和演化建议会出现在这里</div>`;$('reviewAudit').innerHTML=state.audit_log.slice(0,5).map(x=>`<div><strong>${esc(x.action)}</strong><div class="small">${fmt(x.time)} · ${esc(x.detail)}</div></div>`).join('')||'<div class="empty">暂无操作</div>'}
function rollback(v){openConfirm('恢复历史版本？',`正式知识图谱将从当前版本恢复到 v${v}。此操作会进入审计日志。`,()=>perform('/api/action/rollback',{version:v}),{danger:true})}
function renderVersions(){$('currentVersion').textContent=`当前 v${state.graph_version}`;$('versionList').innerHTML=[...state.versions].reverse().map(v=>`<div class="version-item ${v.current?'current':''}"><div class="row"><div><strong>图谱版本 v${v.version}</strong><div class="small">${v.triple_count} 条三元组 ${v.version===0?'· 初始空图谱':'· 经审核的原子更新'}</div></div>${v.current?'<span class="pill good">当前版本</span>':`<button class="secondary" onclick="rollback(${v.version})">恢复</button>`}</div></div>`).join('');$('auditTable').innerHTML=state.audit_log.length?`<table class="table"><thead><tr><th>时间</th><th>类型</th><th>操作</th><th>详细信息</th><th>结果</th></tr></thead><tbody>${state.audit_log.map(x=>`<tr><td>${fmt(x.time)}</td><td>${esc(x.category)}</td><td>${esc(x.action)}</td><td>${esc(x.detail)}</td><td>${x.outcome==='success'?statusPill('done'):statusPill('failed')}</td></tr>`).join('')}</tbody></table>`:'<div class="empty">暂无日志</div>'}
function renderIngestion(){const by={};state.observations.forEach(o=>(by[o.modality]??=[]).push(o));const names={ais:'AIS 北斗',radar:'岸基雷达',video:'视频',remote_sensing:'遥感',meteo_ocean:'气象海况',maritime_text:'海事文本'};$('sources').innerHTML=Object.entries(names).map(([k,n])=>`<div class="source"><strong><span class="dot" style="background:${by[k]?.length?'var(--green)':'#aab4c0'}"></span>${n}</strong><div class="small">${by[k]?.length||0} 条已接收 · ${by[k]?.length?'运行正常':'演示场景未接入'}</div></div>`).join('');$('batchTable').innerHTML=state.batches.length?`<table class="table"><thead><tr><th>批次</th><th>接收时间</th><th>有效</th><th>重复</th><th>状态</th></tr></thead><tbody>${state.batches.map(b=>`<tr><td>${esc(b.id)}</td><td>${fmt(b.received_at)}</td><td>${b.accepted}</td><td>${b.duplicates}</td><td>${statusPill('done')}</td></tr>`).join('')}</tbody></table>`:'<div class="empty">尚未接收批次</div>';$('scenarioInfo').innerHTML=`<strong>${esc(state.scenario.title)}</strong><p>${esc(state.scenario.description)}</p><div class="card"><strong>本场景观察重点</strong><div class="small">${esc(state.scenario.learning_goal)}</div></div>`;$('observationCount').textContent=`共 ${state.observations.length} 条`;$('observationTable').innerHTML=observationTable([...state.observations].reverse())}
function renderOntology(){$('oVersion').textContent='v'+state.ontology.version;$('oMappings').textContent=state.ontology.mapped_field_count;$('oRules').textContent=state.rules.filter(x=>x.enabled).length;$('oProposals').textContent=state.proposals.length;$('ontologyLayers').innerHTML=Object.entries(state.ontology.layers).map(([name,items])=>`<div class="layer"><h3>${esc(name)}</h3><div>${items.map(x=>`<span class="pill">${esc(x)}</span>`).join('')}</div></div>`).join('');$('ruleList').innerHTML=state.rules.map(x=>`<div class="rule"><div><strong>${esc(x.name)}</strong><div class="small">${esc(x.id)}</div></div><div>${esc(x.expression)}<div class="small">${esc(x.last_result)}</div></div><span class="pill good">已启用</span></div>`).join('');$('ontologyReviews').innerHTML=state.proposals.length?state.proposals.map(ontologyCard).join(''):'<div class="empty">当前没有本体演化建议</div>'}
function render(){if(!state)return;$('message').textContent=state.message;$('scenario').value=state.scenario.key;$('sideState').textContent=state.pending_count?`${state.pending_count} 项需要处理`:'系统运行正常';$('sideVersion').textContent=`图谱 v${state.graph_version} · 本体 v${state.ontology.version}`;$('navCount').hidden=!state.pending_count;$('navCount').textContent=state.pending_count;renderOverview();renderTargets();renderReview();renderVersions();renderIngestion();renderOntology();navigate(activeView)}
document.querySelectorAll('.nav-item').forEach(x=>x.onclick=()=>navigate(x.dataset.view));document.querySelectorAll('[data-go]').forEach(x=>x.onclick=()=>navigate(x.dataset.go));
const mobile=document.querySelector('.mobile-nav');document.querySelectorAll('.nav-item').forEach(x=>{const b=document.createElement('button');b.textContent=x.childNodes[0].textContent.trim();b.dataset.view=x.dataset.view;b.onclick=()=>navigate(b.dataset.view);mobile.appendChild(b)});
$('reset').onclick=()=>perform('/api/action/reset',{scenario_key:$('scenario').value});$('receive').onclick=()=>perform('/api/action/receive',{size:4});$('run').onclick=()=>perform('/api/action/run',{});window.addEventListener('hashchange',()=>navigate((location.hash||'#overview').slice(1)));
(async()=>{const data=await api('/api/scenarios');scenarios=data.scenarios;$('scenario').innerHTML=scenarios.map(x=>`<option value="${esc(x.key)}">${esc(x.title)}</option>`).join('');state=await api('/api/state');render()})().catch(e=>$('message').textContent=e.message);
</script>
</body>
