<https://example.org/maritime-kg/resource/area/open-sea-lane-01> a mkg:MaritimeArea .

<https://example.org/maritime-kg/resource/graph-version/1> a mkg:GraphVersion ;
    mkg:graphVersion 1 .

<https://example.org/maritime-kg/resource/observation/ais-412345678-00> a mkg:AISObservation ;
