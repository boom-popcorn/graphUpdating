@prefix ex: <https://example.org/odkg/> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .

ex:ResearchProjectMap a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "projects.csv" ;
    rml:referenceFormulation ql:CSV
  ] ;
  rr:subjectMap [
    rr:template "https://example.org/odkg/project/{id}" ;
    rr:class ex:ResearchProject
  ] .

ex:OrganizationMap a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "organizations.csv" ;
    rml:referenceFormulation ql:CSV
  ] ;
  rr:subjectMap [
    rr:template "https://example.org/odkg/organization/{id}" ;
    rr:class ex:Organization
  ] .

