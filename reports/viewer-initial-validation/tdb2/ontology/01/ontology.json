  "rules": {
    "R1": {
      "id": "R1",
      "name": "low_speed_loitering_state",
      "swrl": "FishingVessel(?v) ^ hasState(?v, ?s) ^ speed(?s, ?x) ^ swrlb:lessThan(?x, 5) -> LoiteringState(?s)",
      "then": {
        "stateType": "LoiteringState"
      },
      "when": {
        "speedLessThan": 5
      }
    },
    "R2": {
      "id": "R2",
      "name": "sensitive_area_risk",
      "swrl": "FishingVessel(?v) ^ hasState(?v, ?s) ^ LoiteringState(?s) ^ locatedIn(?v, ?a) ^ SensitiveArea(?a) -> hasPotentialIllegalActivity(?v, ?a)",
      "then": {
        "relation": "hasPotentialIllegalActivity"
      },
      "when": {
        "inSensitiveArea": true,
        "stateType": "LoiteringState"
      }
    },
    "R3": {
      "id": "R3",
      "name": "suspected_illegal_fishing_candidate",
      "plannerAction": "materialize SuspectedIllegalFishingActivity using the deterministic event ID",
      "swrlPattern": "hasPotentialIllegalActivity(?v, ?a) ^ hasState(?v, ?s) ^ durationSeconds(?s, ?d) ^ swrlb:greaterThan(?d, 600) ^ travelDistance(?s, ?m) ^ swrlb:lessThan(?m, 0.5)",
      "then": {
        "eventType": "SuspectedIllegalFishingActivity"
      },
      "when": {
        "durationSecondsGreaterThan": 600,
        "travelDistanceLessThan": 0.5
      }
    },
    "R4": {
      "id": "R4",
      "name": "identity_conflict",
      "plannerAction": "materialize identity conflict from declaration and inspection evidence",
      "then": {
        "eventType": "IdentityConflict"
      },
      "when": {
        "declaredTypes": [
          "捕捞船",
          "渔船"
        ]
      }
    },
    "R5": {
      "id": "R5",
      "name": "communication_anomaly",
      "plannerAction": "materialize anomaly from unanswered calls and encrypted message count in round window",
      "then": {
        "eventType": "CommunicationAnomaly"
      },
      "when": {
        "callAttemptsAtLeast": 3,
        "encryptedMessageCountAtLeast": 20
      }
    },
    "R6": {
      "id": "R6",
      "name": "report_corroboration",
      "plannerAction": "raise candidate confidence and threat level using report, loitering and sensitive area",
      "then": {
        "confidenceBonus": 0.05,
        "confidenceCap": 0.99,
        "threatLevel": "elevated"
      },
      "when": {
        "inSensitiveArea": true,
        "requiresRule": "R1"
      }
    }
  },
  "versionId": "01"
}
